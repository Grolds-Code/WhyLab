# WhyLab LLM configuration
# Required for generic causal-question generation.
WHYLAB_LLM_API_KEY=

# Optional: defaults shown below.
WHYLAB_LLM_MODEL=openrouter/free
WHYLAB_LLM_BASE_URL=https://openrouter.ai/api/v1

# Local persistence
WHYLAB_DB_PATH=whylab.db

# MCP server configuration
# Default transport is stdio.
WHYLAB_MCP_TRANSPORT=stdio

# Used when WHYLAB_MCP_TRANSPORT=streamable-http
WHYLAB_MCP_HOST=127.0.0.1
WHYLAB_MCP_PORT=8000
